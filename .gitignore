# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key

# Virtualenv / Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/

# Data layers.
# Everything under data/raw/ is either a read-only clone, an immutable copy of
# an API response, or an extract derived from one of those. All of it is large,
# all of it is reproducible from the source repository plus a token, and none of
# it belongs in the history of a general-purpose tool. `impact ingest-git` and
# `impact ingest-github` rebuild the whole tree.
data/raw/
data/normalized/
data/derived/
artifacts/*.parquet
artifacts/*.zip

# Committed on purpose:
#   data/samples/**        tiny redacted fixtures used by unit tests
#   docs/fixtures/phase3/  the synthetic export CI builds the site against
#   artifacts/*.json       compact manifests / coverage reports for Phase 2

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# Logs
logs/
*.log

# Node dependencies (Phase 3 web app) — never tracked
node_modules/
web/node_modules/
web/dist/
web/.next/

# ---------------------------------------------------------------- phase 3 ---
# The Phase 3 export is a generated build input (~190 MB) and the built site is
# a generated build output (~300 MB). Neither belongs in the source history;
# docs/DEPLOYMENT_RUNBOOK.md explains how each is reproduced.
artifacts/phase3/
web/.data/
web/out/
web/test-results/
web/playwright-report/
web/*.tsbuildinfo
web/shot*.mjs
data/phase2/

# ------------------------------------------------------------- working docs ---
# Planning documents handed to coding agents, and the historical phase handovers.
# Both are working material for whoever is building this, not part of the
# published project. Track docs live in .plans/, outcomes in .plans/completed/.
.plans/
.archive/
