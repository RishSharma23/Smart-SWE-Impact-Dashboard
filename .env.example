# Copy to .env and fill in.  .env is git-ignored; never commit real values.
#
# GITHUB_TOKEN — required.
#   Preferred: a GitHub fine-grained personal access token scoped to
#   "Public repositories (read-only)". No write scopes are ever needed.
#   Create at: https://github.com/settings/personal-access-tokens/new
#   Alternative: leave unset and the pipeline falls back to `gh auth token`
#   from an authenticated GitHub CLI.
GITHUB_TOKEN=

# Optional overrides (defaults live in config/*.yaml)
# IMPACT_WINDOW_START=2026-05-19T00:00:00Z
# IMPACT_WINDOW_END=2026-08-17T00:00:00Z
# IMPACT_DATA_DIR=data
